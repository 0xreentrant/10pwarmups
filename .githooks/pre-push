#!/usr/bin/env bash
# Fail push when TypeScript project references do not typecheck.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

if [[ -s "${HOME}/.nvm/nvm.sh" ]]; then
  # shellcheck disable=SC1091
  source "${HOME}/.nvm/nvm.sh"
  nvm use >/dev/null
fi

echo "pre-push: npm run type-check"
npm run type-check
